datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  loginType    String
  name         String
  city         String
  coName       String?
  active       Boolean?      @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  RefreshToken RefreshToken?
}

model RefreshToken {
  id        String @id @default(uuid())
  token     String @unique
  expiresIn Int
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TypeOfRecord {
  POSl
  POSll
  POSlll
}

enum RecordRoleType {
  base
  auxiliar
  coordinator
  liturgy
  secretary
  kitchenSpiritual
  coupleKitchenCoordinator
  auxiliarLiturgy
  auxiliarSecretary
  bar
  coupleSafeToBe
  folkloreCoordinator
  kitchen
}

enum TypeOfficeWorkKitchenMember {
  cleanWork
  copeWork
  kitchenWork
}

model Course {
  id                       String       @id @default(uuid())
  typeOfCourse             TypeOfRecord @default(POSl)
  courseNumber             String
  startDate                String
  endDate                  String
  base                     String
  auxiliar                 String
  coordinator              String
  liturgy                  String
  secretary                String
  kitchenSpiritual         String
  coupleKitchenCoordinator String

  @@unique([typeOfCourse, courseNumber])
}

model Participant {
  id String @id @default(uuid())

  recordId String?
  poslllId String?

  record RecordEntity? @relation(fields: [recordId], references: [id], onDelete: Cascade)
  poslll Poslll?       @relation(fields: [poslllId], references: [id], onDelete: Cascade)

  recordRoles RecordRole[]
}

model RecordEntity {
  id             String        @id @default(uuid())
  typeOfRecord   TypeOfRecord? @default(POSl)
  courseNumber   String
  recordNumber   String
  candidateName  String
  nickname       String
  birthDate      String
  candidatePhone String
  isWork         Boolean       @default(false)
  isCoupleWork   Boolean       @default(false)
  parishChapel   String
  dataConsent    Boolean
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  createdById    String
  recordPOSl     RecordPOSl?
  recordPOSll    RecordPOSll?
  recordPOSlll   RecordPOSlll?
  recordWork     RecordWork?
  recordCouple   RecordCouple?
  participants   Participant[]
}

model RecordPOSl {
  id                     String       @id @default(uuid())
  recordId               String       @unique
  record                 RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
  godfatherName          String
  godfatherPhone         String
  candidateSpirit        String
  candidateDisposition   String
  candidateParticipation String
}

model RecordPOSll {
  id       String       @id @default(uuid())
  recordId String       @unique
  record   RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordPOSlll {
  id       String       @id @default(uuid())
  recordId String       @unique
  record   RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordWork {
  id       String       @id @default(uuid())
  recordId String       @unique
  record   RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordCouple {
  id             String       @id @default(uuid())
  womanName      String
  womanNickname  String
  womanPhone     String
  womanBirthDate String
  recordId       String       @unique
  record         RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model Poslll {
  id             String        @id @default(uuid())
  candidateName  String        @unique
  parishChapel   String        @default("Novo Hamburgo")
  courseOne      String
  courseTwo      String
  courseThree    String
  formations     String
  instagram      String?       @default("@cljdiocesenh")
  instagramWoman String?       @default("@cljdiocesenh")
  isCouple       Boolean?      @default(false)
  participants   Participant[]

  active    Boolean? @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CommunityMember {
  id          String    @id @default(uuid())
  recordId    String
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model Community {
  id          String            @id @default(uuid())
  number      String
  workTableId String
  workTable   WorkTableEntity   @relation(fields: [workTableId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
}

model KitchenMember {
  id          String                      @id @default(uuid())
  office      TypeOfficeWorkKitchenMember
  recordId    String
  workTableId String
  workTable   WorkTableEntity             @relation(fields: [workTableId], references: [id], onDelete: Cascade)

  @@unique([workTableId, office, recordId])
}

model WorkTableEntity {
  id                  String          @id @default(uuid())
  courseId            String          @unique
  auxiliarLiturgy     String?
  auxiliarSecretary   String?
  bar                 String?
  coupleSafeToBe      String?
  folkloreCoordinator String?
  kitchenRecords      KitchenMember[]
  communities         Community[]
}

model RecordRole {
  id            String         @id @default(uuid())
  participantId String
  role          RecordRoleType
  courseId      String
  workTableId   String?

  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([participantId, role, courseId])
  @@index([role, courseId])
}
