generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  loginType    String
  name         String
  city         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  RefreshToken RefreshToken?
}

model RefreshToken {
  id        String @id @default(uuid())
  token     String @unique
  expiresIn Int
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           String @id @default(uuid())
  typeOfCourse String @default("POSl")
  courseNumber Int
  startDate    String
  endDate      String
}

model Record {
  id                      String        @id @default(uuid())
  typeOfRecord            String
  courseNumber            Int
  parishAcronym           String
  recordNumber            Int
  candidateName           String
  nickname                String
  birthDate               String
  candidatePhone          String
  instagram               String
  priest                  String
  parishChapel            String
  spiritualLife           String[]
  observationsCoordinator String        @default("")
  observationsDed         String
  disease                 String?
  medication              String?
  allergy                 String?
  dataConsent             Boolean
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @default(now()) @updatedAt
  recordPOSl              RecordPOSl?
  recordPOSll             RecordPOSll?
  recordWork              RecordWork?
  recordCouple            RecordCouple?
}

model RecordPOSl {
  id                      String   @id @default(uuid())
  godfatherName           String
  godfatherPhone          String
  godfatherEmail          String
  affinityWithGodfather   String
  attitudeCommunication   String
  doctrineCommunication   String
  godfatherResponsibility String
  candidateSpirit         String
  candidateDisposition    String
  candidateParticipation  String
  fatherSituation         String
  motherSituation         String
  livesWith               String[]
  otherWho                String?
  parentsReligion         String?
  otherReligion           String?
  parentsComment          String
  recordId                String   @unique
  record                  Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordPOSll {
  id                      String   @id @default(uuid())
  courseOneDone           String
  motivationToParticipate String
  reasonForCLJII          String
  approachToChrist        String
  acceptsChurchDoctrine   String
  commitmentToCLJ         String
  perseveranceInCommunity String
  hideImportantInfo       Boolean
  currentGroupFunction    String
  parishChapelActivities  String
  doingConfirmation       Boolean?
  notConfirmationBecause  String?
  recordId                String   @unique
  record                  Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordWork {
  id                     String   @id @default(uuid())
  courseOneDone          String
  courseTwoDone          String
  courseThreeDone        String?
  workedInWhichCourses   String
  graceStateAwareness    String
  notFalsifyData         Boolean
  showLifeTestimony      String
  currentGroupFunction   String
  parishActivities       String
  doingConfirmation      Boolean?
  notConfirmationBecause String?
  instrument             String?
  reasonToWork           String
  workPreference         String
  willingToOtherFunction Boolean
  parishIndication       String[]
  recordId               String   @unique
  record                 Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordCouple {
  id                      String  @id @default(uuid())
  workPreference          String
  externalCouple          Boolean
  cookCouple              Boolean
  womanName               String
  womanNickname           String
  womanPhone              String
  womanInstagram          String
  womanBirthDate          String
  coursesDone             String
  religiousWeddingDate    String
  participatedInRetreat   Boolean
  motivationToParticipate String
  parishIndication        String
  willingToOtherFunction  Boolean
  recordId                String  @unique
  record                  Record  @relation(fields: [recordId], references: [id], onDelete: Cascade)
}
