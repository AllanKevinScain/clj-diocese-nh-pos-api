datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  loginType    String
  name         String
  city         String
  coName       String?
  active       Boolean?      @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  RefreshToken RefreshToken?
}

model RefreshToken {
  id        String @id @default(uuid())
  token     String @unique
  expiresIn Int
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TypeOfRecord {
  POSl
  POSll
  POSlll
}

model Course {
  id                       String       @id @default(uuid())
  typeOfCourse             TypeOfRecord @default(POSl)
  courseNumber             String
  startDate                String
  endDate                  String
  base                     String
  auxiliar                 String
  coordinator              String
  liturgy                  String
  secretary                String
  kitchenSpiritual         String
  coupleKitchenCoordinator String

  @@unique([typeOfCourse, courseNumber])
}

model RecordEntity {
  id             String        @id @default(uuid())
  typeOfRecord   TypeOfRecord? @default(POSl)
  courseNumber   String
  recordNumber   String
  candidateName  String
  nickname       String
  birthDate      String
  candidatePhone String
  isWork         Boolean       @default(false)
  isCoupleWork   Boolean       @default(false)
  parishChapel   String
  dataConsent    Boolean
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  createdById    String
  recordPOSl     RecordPOSl?
  recordPOSll    RecordPOSll?
  recordPOSlll   RecordPOSlll?
  recordWork     RecordWork?
  recordCouple   RecordCouple?
}

model RecordPOSl {
  id                     String       @id @default(uuid())
  recordId               String       @unique
  record                 RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
  godfatherName          String
  godfatherPhone         String
  candidateSpirit        String
  candidateDisposition   String
  candidateParticipation String
}

model RecordPOSll {
  id       String       @id @default(uuid())
  recordId String       @unique
  record   RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordPOSlll {
  id       String       @id @default(uuid())
  recordId String       @unique
  record   RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordWork {
  id       String       @id @default(uuid())
  recordId String       @unique
  record   RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model RecordCouple {
  id             String       @id @default(uuid())
  recordId       String       @unique
  record         RecordEntity @relation(fields: [recordId], references: [id], onDelete: Cascade)
  womanName      String
  womanNickname  String
  womanPhone     String
  womanBirthDate String
}

model Poslll {
  id             String   @id @default(uuid())
  candidateName  String   @unique
  parishChapel   String   @default("Novo Hamburgo")
  courseOne      String
  courseTwo      String
  courseThree    String
  formations     String
  instagram      String?  @default("@cljdiocesenh")
  instagramWoman String?  @default("@cljdiocesenh")
  isCouple       Boolean? @default(false)

  active    Boolean? @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Community {
  id          String            @id @default(uuid())
  number      String
  workTableId String
  workTable   WorkTableEntity   @relation(fields: [workTableId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  recordId    String
}

model WorkTableEntity {
  id                  String      @id @default(uuid())
  courseNumber        String      @unique
  auxiliarLiturgy     String?
  auxiliarSecretary   String?
  bar                 String?
  coupleSafeToBe      String?
  folkloreCoordinator String?
  cleanWorkRecords    String[]
  copeWorkRecords     String[]
  kitchenWorkRecords  String[]
  communities         Community[]
}
